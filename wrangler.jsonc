{
  "name": "colinha",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": false, "logs": { "invocation_logs": false } },
  "ratelimits": [
    {
      "name": "SIGN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "ratelimits": [
        {
          "name": "SIGN_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "observability": {
        "enabled": false,
        "logs": { "invocation_logs": false },
      },
    },
    "production": {
      "workers_dev": false,
      "routes": [{ "pattern": "colinha.app", "custom_domain": true }],
      "ratelimits": [
        {
          "name": "SIGN_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "observability": {
        "enabled": false,
        "logs": { "invocation_logs": false },
      },
    },
  },
}
